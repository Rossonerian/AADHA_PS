# Copy this file to .env at the repository root for the Python API.
# For Next.js, copy the web/shared sections into apps/web/.env.local;
# on Render/Vercel, enter the relevant values in that service's environment.
# Replace every replace-with/your-* placeholder. Keep secrets server-side.

# REQUIRED provider keys for the complete Verifier (API / Render)
# OpenRouter: https://openrouter.ai/settings/keys - text claim extraction
OPENROUTER_API_KEY=replace-with-openrouter-api-key
# Google AI Studio: https://aistudio.google.com/apikey - captionless video transcription
GEMINI_API_KEY=replace-with-google-ai-studio-api-key
# Tavily: https://app.tavily.com - display-only provider search links
TAVILY_API_KEY=tvly-replace-with-your-tavily-api-key
# Finnhub: https://finnhub.io/dashboard - Nasdaq capstone data
FINNHUB_API_KEY=replace-with-finnhub-api-key

# Provider settings: keep these defaults unless deliberately changing models.
OPENROUTER_DEFAULT_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_TRANSCRIBE_MODEL=gemini-4-hydrogen
WEB_SEARCH_PROVIDER=tavily
TIP_QUALITY_WEIGHT=0
# Optional legacy aliases only; you do NOT need to fill these too:
# GOOGLE_AI_STUDIO_API_KEY= (used only when GEMINI_API_KEY is empty)
# WEB_SEARCH_API_KEY= (Tavily key used only when TAVILY_API_KEY is empty)

# REQUIRED Neon connection values (copy from your Neon project)
# Pooled URL: API / Render and Next.js server / Vercel.
# Standard postgresql:// works for both; Python normalizes its driver internally.
DATABASE_URL=postgresql://your-user:your-password@your-project-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Direct URL: API migrations / CLI. Never point tests at the production schema.
DATABASE_URL_UNPOOLED=postgresql://your-user:your-password@your-project.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# REQUIRED Neon Auth base URL (API / Render and Next.js server / Vercel)
# For Google sign-in, set the Google OAuth Client ID/Secret in the Neon Console,
# not this file. These OAuth credentials are separate from GEMINI_API_KEY.
NEON_AUTH_BASE_URL=https://your-auth-endpoint.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
# Optional API override: leave empty to derive <NEON_AUTH_BASE_URL>/.well-known/jwks.json.
NEON_AUTH_JWKS_URL=
# Optional strict JWT claim checks (API verifies them only when set).
JWT_ISSUER=
JWT_AUDIENCE=
# REQUIRED on Next.js server / Vercel: generate your own random secret >=32 characters.
# Example generator: python -c "import secrets; print(secrets.token_hex(32))"
NEON_AUTH_COOKIE_SECRET=replace-with-a-generated-random-cookie-secret

# Neon Object Storage (Next.js server / Vercel, if using Storage/health integration)
# Use the Neon Storage S3 credentials and endpoint, not an unrelated AWS account.
AWS_ACCESS_KEY_ID=replace-with-neon-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-neon-storage-secret-key
AWS_ENDPOINT_URL_S3=https://your-neon-storage-endpoint
AWS_REGION=replace-with-your-neon-storage-region

# Neon Realtime (Next.js server / Vercel, if using Realtime/health integration)
NEON_REALTIME_URL=https://your-project.realtime.ap-southeast-1.aws.neon.tech
NEON_REALTIME_SECRET=replace-with-your-neon-realtime-signing-secret

# URLs to set for your deployment (local defaults shown)
# API / Render: set APP_ENV=production and CORS_ORIGINS to your web origin(s).
# For local development, keep the defaults below.
APP_ENV=development
APP_VERSION=0.1.0
# In production an unset CORS_ORIGINS blocks all cross-origin requests; /docs, /redoc and
# /openapi.json are disabled when APP_ENV=production.
CORS_ORIGINS=http://localhost:3000
# Web / Vercel: API URL must include /api/v1; NEXT_PUBLIC_* values are public.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Optional alias read only when NEXT_PUBLIC_API_URL is empty; prefer NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_USE_MOCKS=false
# DEV ONLY (mock mode): mock data level, default 2. Never set in production.
# NEXT_PUBLIC_MOCK_LEVEL=2
# Next.js server only: enables the dev diagnostic /api/neon/verify route in production.
# Keep UNSET in production.
# ENABLE_NEON_VERIFY=
# Use the same endpoint as NEON_REALTIME_URL; this URL is public, its secret is not.
NEXT_PUBLIC_NEON_REALTIME_URL=https://your-project.realtime.ap-southeast-1.aws.neon.tech

# API operational defaults - no additional provider keys needed below
LOG_LEVEL=INFO
EDU_PASS_ACCURACY=0.70
EDU_MAX_BRIER=0.25
MARKET_DATA_DIR=data/seed/market
MARKET_DATA_MAX_STALE_DAYS=5
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_USER_PER_WINDOW=20
RATE_LIMIT_IP_PER_WINDOW=60
# Max tracked rate-limit buckets (idle ones evicted first).
RATE_LIMIT_MAX_BUCKETS=50000
# Number of trusted reverse proxies in front of the API. 0 = ignore X-Forwarded-For
# and use the socket peer; set to 1 behind a single proxy (e.g. Render).
TRUSTED_PROXY_HOPS=0
MAX_REQUEST_BODY_BYTES=1048576
MAX_VERIFY_BODY_BYTES=10485760

# Web: detailed /api/neon/health diagnostics are returned only when the request carries
# header `x-health-token: <HEALTH_DETAIL_TOKEN>`; otherwise the route returns just {"ok": bool}.
HEALTH_DETAIL_TOKEN=

# Smoke test (infra/scripts/smoke_test.py) - optional, never commit real values
# STAGING_API_URL=https://your-api-host/api/v1
# SMOKE_TEST_JWT=
# SMOKE_TEST_EMAIL=
# SMOKE_TEST_PASSWORD=
# SMOKE_TEST_ORIGIN=http://localhost:3000
# SMOKE_AUTH_BASE_URL= (defaults to NEON_AUTH_BASE_URL)
