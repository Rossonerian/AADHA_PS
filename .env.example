# Application
APP_ENV=development
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aacharya

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret

# LLM (OpenRouter via core.llm.complete)
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Market Data
MARKET_DATA_DIR=data/seed/market

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
