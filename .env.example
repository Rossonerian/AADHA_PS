# Application
APP_ENV=development
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:3000

# Database (Neon Lakebase Postgres)
DATABASE_URL=postgresql+psycopg://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql+psycopg://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_AUTH_COOKIE_SECRET=replace-with-32-byte-cookie-secret

# Neon Object Storage (S3-compatible)
AWS_ACCESS_KEY_ID=replace-with-neon-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-neon-storage-secret-key
AWS_ENDPOINT_URL_S3=https://storage.us-east-2.aws.neon.tech
AWS_REGION=us-east-2

# Neon Realtime
NEON_REALTIME_URL=https://ep-example.realtime.us-east-2.aws.neon.tech
NEON_REALTIME_SECRET=replace-with-neon-realtime-secret

# LLM (OpenRouter via core.llm.complete)
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_DEFAULT_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Finnhub (Nasdaq literacy verifier; factual endpoints only)
FINNHUB_API_KEY=replace-with-finnhub-api-key

# Market Data
MARKET_DATA_DIR=data/seed/market

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_NEON_REALTIME_URL=https://ep-example.realtime.us-east-2.aws.neon.tech
