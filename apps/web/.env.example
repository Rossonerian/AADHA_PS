NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Local development/tests only: serves fixtures and skips sign-in. Ignored in production builds.
NEXT_PUBLIC_USE_MOCKS=false
# Optional alias read only when NEXT_PUBLIC_API_URL is empty.
# NEXT_PUBLIC_API_BASE_URL=
# DEV ONLY (mock mode): mock data level, default 2. Never set in production.
# NEXT_PUBLIC_MOCK_LEVEL=2
# Server-side: enables dev diagnostic /api/neon/verify in production. Keep UNSET in prod.
# ENABLE_NEON_VERIFY=
