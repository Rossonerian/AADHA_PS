# Backend API Base URL (defaults to Render deployment in production if omitted)
NEXT_PUBLIC_API_URL=https://aadha-ps.onrender.com/api/v1

# Local development/tests only: serves fixtures and skips sign-in. Set to false for live backend.
NEXT_PUBLIC_USE_MOCKS=false

# Neon Auth Base URL (defaults to Neon managed auth endpoint if omitted)
NEON_AUTH_BASE_URL=https://ep-misty-paper-azc60pot.neonauth.c-3.ap-southeast-1.aws.neon.tech/neondb/auth

# Neon Auth Cookie Secret (min 32 chars, used to encrypt auth session cookies)
NEON_AUTH_COOKIE_SECRET=Og7KpaaFTr+RObMeqpks0WuYOBcslAPp8bt4MbH3D5w=

# Neon Realtime WebSocket URL (defaults to Neon realtime endpoint if omitted)
NEXT_PUBLIC_NEON_REALTIME_URL=wss://ep-misty-paper-azc60pot.rt.c-3.ap-southeast-1.aws.neon.tech/

# Optional alias read only when NEXT_PUBLIC_API_URL is empty.
# NEXT_PUBLIC_API_BASE_URL=
# DEV ONLY (mock mode): mock data level, default 2. Never set in production.
# NEXT_PUBLIC_MOCK_LEVEL=2
# Server-side: enables dev diagnostic /api/neon/verify in production. Keep UNSET in prod.
# ENABLE_NEON_VERIFY=
